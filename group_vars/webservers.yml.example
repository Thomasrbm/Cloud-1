---
# MODÈLE, pour repartir de zéro. Copie-le en group_vars/webservers.yml, mets
# tes propres valeurs, puis CHIFFRE-LE — c'est obligatoire, la version chiffrée
# est versionnée dans git :
#   ansible-vault encrypt group_vars/webservers.yml
# Un dépôt qui contiendrait ce fichier en clair serait une faute.
mysql_root_password: change_me_root
mysql_database: wordpress
mysql_user: wp_user
mysql_password: change_me_user

# Mot de passe du compte administrateur WordPress
wp_admin_password: change_me_admin
