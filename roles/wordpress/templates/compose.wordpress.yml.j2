# Le site (PHP). Déposé par le rôle wordpress.
services:
  wordpress:
    image: wordpress:php8.1-fpm
    restart: always
    depends_on:
      - mysql
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_NAME: ${MYSQL_DATABASE}
      WORDPRESS_DB_USER: ${MYSQL_USER}
      WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - wp_data:/var/www/html   # volume nommé : le site survit au reboot
    networks:
      - wp_network
    # Variante -fpm : PHP tout seul, sans serveur web. C'est nginx qui écoute
    # sur 80/443 et lui passe le PHP en interne, sur 9000.

  # Outil en ligne de commande WordPress. 'profiles' l'empeche de demarrer avec
  # la stack : il n'est lance qu'a la demande, par 'docker compose run wpcli ...'
  # (conteneur ephemere, supprime des la commande terminee).
  wpcli:
    image: wordpress:cli
    profiles:
      - tools
    depends_on:
      - mysql
      - wordpress
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_NAME: ${MYSQL_DATABASE}
      WORDPRESS_DB_USER: ${MYSQL_USER}
      WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      # Meme volume que WordPress : wp-cli agit sur les memes fichiers.
      - wp_data:/var/www/html
    networks:
      - wp_network
    # UID/GID de www-data : les fichiers crees restent lisibles par php-fpm.
    user: "33:33"
