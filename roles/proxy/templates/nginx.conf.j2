
# selon la requete nginx utilise le bloc server qui correspond
# a la requete

# il choisit d apres le port  (un bloc peut listen plusieurs ports)
# plusieur bock peuvent listen le meme port 



# il recoit les port depuis le compose ou il redirige des port pc vers 
# port docker 


# HTTP -> redirection HTTPS
server {
    listen 80;   # écoute les visiteurs qui arrivent en HTTP (port 80), quel que soit le nom demandé (seul bloc sur ce port)

    # 301 = redirection definitive
    # force le https
    # host = ip server
    # request uri = le chemin / sur le srv
    return 301 https://$host$request_uri;
}



server {
    listen 443 ssl; # chiffre ce port, repond a tout (seul bloc sur ce port)

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    root /var/www/html;
    index index.php;





    # A DECOMMENTER 
   
    # location = /preuve {
    #     default_type text/html;
    #     return 200 '<h1>Deploye par Ansible</h1><p>Thomas - Cloud-1</p>';
    # }






    #  ^~  = pour tout ce qui commence par ...
    # /phpmyadmin sans le / final : nginx redirige tout seul vers /phpmyadmin/
    location ^~ /phpmyadmin/ {
        proxy_pass http://phpmyadmin:80/; #  comme ils sont sur 
        # meme reseau docker wp_network juste avec le nom il redirige
        # vers le bon container
        proxy_set_header Host $host; # ip de la requete du nav
        proxy_set_header X-Forwarded-Proto $scheme; #  https
    }



    # pour tous les truc qui sont pas php myadmin
    # il check la requete demande sinon il renvoit vers wordpress

    # WordPress
    location / {
        try_files $uri $uri/ /index.php?$args;
    }



    # block qui exec le php de wordpress
    # regex pour toute url qui fini en php

    location ~ \.php$ {
        fastcgi_pass wordpress:9000; # envoit a php fpm dans le conteneur
                        # nom du container et port par defaut de fpm

        include fastcgi_params; # charge le fichier avec la requete
        #  GET POST ETC + HTTPS=on (sinon wordpress redirige en boucle)

        # chemin du fichier a execute
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
