# HTTP -> redirection HTTPS
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host{% if https_port | int != 443 %}:{{ https_port }}{% endif %}$request_uri;
}

# Serveur HTTPS par défaut : WordPress à la racine, phpMyAdmin sur /phpmyadmin/.
# Accessible directement par l'IP du serveur (aucun domaine requis).
server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    root /var/www/html;
    index index.php;

    # phpMyAdmin
    location = /phpmyadmin {
        return 301 /phpmyadmin/;
    }
    # ^~ est indispensable : sans lui, nginx teste quand meme le bloc regex
    # \.php$ plus bas, qui l'emporte sur un simple prefixe. /phpmyadmin/index.php
    # partait alors vers le php-fpm de WordPress, qui repondait "File not found."
    # Avec ^~, des que le prefixe correspond nginx arrete de chercher.
    location ^~ /phpmyadmin/ {
        proxy_pass http://phpmyadmin:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WordPress
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass wordpress:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # nginx termine le TLS et parle en clair a php-fpm : sans ce parametre
        # WordPress se croit en HTTP alors que son URL est en HTTPS, ce qui
        # provoque une boucle de redirection dans /wp-admin.
        fastcgi_param HTTPS on;
    }
}
