# Le reverse-proxy et le TLS. Déposé par le rôle proxy.
services:
  nginx:
    image: nginx:alpine
    restart: always
    depends_on:
      - wordpress
      - phpmyadmin
    ports:
      - "{{ http_port }}:80"
      - "{{ https_port }}:443"
    volumes:
      # Config et certificats : montés en lecture seule (:ro).
      - {{ project_dir }}/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ project_dir }}/ssl:/etc/nginx/ssl:ro
      # Mêmes fichiers que WordPress : nginx sert les images et le CSS
      # directement, sans passer par PHP.
      - wp_data:/var/www/html
    networks:
      - wp_network
    # Le SEUL service qui publie des ports. Tout le reste reste interne.
