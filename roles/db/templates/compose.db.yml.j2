# La base de données. Déposé par le rôle db.
# 1 process = 1 container. Secrets injectés via .env (jamais en dur).
services:
  mysql:
    image: mysql:8.0
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - mysql_data:/var/lib/mysql   # volume nommé : survit au reboot
    networks:
      - wp_network
    # Pas de ports exposés : la base n'est jamais joignable depuis Internet,
    # seulement sur wp_network, en 3306.
