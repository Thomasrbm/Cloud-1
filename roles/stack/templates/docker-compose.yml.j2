# ==============================================================================
# FICHIER DE BASE : reseau + volumes partages.
#
# Il ne declare AUCUN service : chaque composant apporte le sien dans son
# propre fichier (compose.db.yml, compose.wordpress.yml, ...), depose par son
# role Ansible. Docker Compose fusionne la liste donnee par COMPOSE_FILE (.env).
#
# Consequence : `cd {{ project_dir }} && docker compose ps` voit la stack
# entiere, mais chaque partie reste deployable seule.
# ==============================================================================

networks:
  wp_network:
    driver: bridge

# Volumes NOMMES (et non bind mounts) : ils apparaissent dans `docker volume ls`
# et s'inspectent avec `docker volume inspect`, comme demande en soutenance.
volumes:
  mysql_data:   # base de donnees
  wp_data:      # fichiers du site (themes, uploads, plugins)
