# Fichier de base : le réseau et les volumes, rien d'autre.
# Chaque composant apporte son propre service dans son fichier (compose.db.yml,
# compose.wordpress.yml...), déposé par son rôle. Docker fusionne la liste
# donnée par COMPOSE_FILE dans le .env.

networks:
  wp_network:
    driver: bridge

# Volumes NOMMÉS (pas des bind mounts) : ils apparaissent dans docker volume ls
# et s'inspectent avec docker volume inspect. Les données survivent à la
# destruction des conteneurs.
volumes:
  mysql_data:   # la base
  wp_data:      # les fichiers du site (images, thèmes, plugins)
