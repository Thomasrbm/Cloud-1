# Généré par Ansible depuis group_vars — ne jamais committer ce fichier.
# Il contient les mots de passe en clair : 0600 sur le serveur, jamais dans git.

# La liste des fichiers compose à fusionner. Grâce à elle, un simple
# docker compose ps dans {{ project_dir }} voit les 4 services d'un coup.
COMPOSE_FILE={{ compose_files | join(':') }}

MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}
