# Genere par Ansible depuis group_vars (chiffre) - ne jamais committer.

# Liste des fichiers compose fusionnes. Grace a cette variable, un simple
# `docker compose ps` dans {{ project_dir }} voit les 4 services.
COMPOSE_FILE={{ compose_files | join(':') }}

MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}
